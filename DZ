# 1. Запитання
questions = [
    "Ім'я?", "Вік?", "Місто?", "Хобі?", "Колір?", 
    "Страва?", "Фільм?", "Мова?", "Ціль?", "Настрій?"
]
answers = [input(f"{i+1}. {q} ") for i, q in enumerate(questions)]

# 2. Відповіді користувача отримано під час створення списку answers

# 3. Вивід результатів
print("\n#1 Конкатенація:")
for i in range(10):
    print("Питання: " + questions[i] + " -> Відповідь: " + answers[i])

print("\n#2 f-форматування:")
for i in range(10):
    print(f"Питання: {questions[i]} -> Відповідь: {answers[i]}")
